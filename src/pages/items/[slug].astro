---
import Layout from '../../layouts/Layout.astro'; import { items } from '../../data/site'; import { link } from '../../lib/paths';
export function getStaticPaths() { return items.map((item) => ({ params: { slug: item.slug }, props: { item } })); }
const { item } = Astro.props;
---
<Layout title={item.name}><section class={`px-5 py-20 ${item.color}`}><div class="mx-auto max-w-4xl text-center"><span class="text-7xl">{item.icon}</span><p class="mt-5 text-xs font-bold tracking-[0.2em] text-emerald-700">ITEM CATEGORY</p><h1 class="mt-3 text-4xl font-bold text-emerald-950">{item.name}</h1><p class="mt-5 text-stone-600">{item.description}を中心に、幅広くお取り扱いしています。</p></div></section><section class="mx-auto max-w-4xl px-5 py-16"><h2 class="text-2xl font-bold text-emerald-950">査定のポイント</h2><div class="mt-6 grid gap-4 sm:grid-cols-3"><div class="rounded-xl bg-stone-100 p-5"><b class="block text-emerald-900">状態</b><p class="mt-2 text-sm leading-6 text-stone-600">傷や使用感がある品もご相談ください。</p></div><div class="rounded-xl bg-stone-100 p-5"><b class="block text-emerald-900">付属品</b><p class="mt-2 text-sm leading-6 text-stone-600">箱や保証書があれば一緒にお持ちください。</p></div><div class="rounded-xl bg-stone-100 p-5"><b class="block text-emerald-900">市場動向</b><p class="mt-2 text-sm leading-6 text-stone-600">最新の市場価格を査定に反映します。</p></div></div><a href={link('/contact/')} class="mt-10 inline-block rounded-full bg-emerald-800 px-6 py-3 font-bold text-white">この品目について相談する</a></section></Layout>
