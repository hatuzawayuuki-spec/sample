---
interface Props { title: string; lead?: string; eyebrow?: string }
const { title, lead, eyebrow = 'TSUNAGUYA' } = Astro.props;
---
<section class="bg-stone-100"><div class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-20"><p class="text-xs font-bold tracking-[0.22em] text-emerald-700">{eyebrow}</p><h1 class="mt-4 text-3xl font-bold tracking-tight text-emerald-950 lg:text-5xl">{title}</h1>{lead && <p class="mt-5 max-w-2xl leading-8 text-stone-600">{lead}</p>}</div></section>
